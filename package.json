{
  "name": "mist-story",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start --filter=@mist/web --filter=@mist/api --filter=@mist/worker",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "dev:web": "pnpm --filter @mist/web dev",
    "dev:api": "pnpm --filter @mist/api dev",
    "dev:worker": "pnpm --filter @mist/worker dev",
    "start:web": "pnpm --filter @mist/web start",
    "start:api": "pnpm --filter @mist/api start",
    "start:worker": "pnpm --filter @mist/worker start",
    "db:generate": "dotenv -e ./.env.local -- pnpm --filter @mist/db db:generate",
    "db:migrate": "dotenv -e ./.env.local -- pnpm --filter @mist/db db:migrate",
    "db:studio": "dotenv -e ./.env.local -- pnpm --filter @mist/db db:studio",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22",
    "@types/ws": "^8.18.1",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.22.0",
    "eslint-config-next": "16.1.6",
    "globals": "^15.15.0",
    "tsx": "^4.19.3",
    "turbo": "^2.4.4",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.26.1"
  }
}
