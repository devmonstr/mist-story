{
  "name": "@mist/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "build": "bun --bun tsc -p tsconfig.json --noEmit",
    "lint": "bun --bun eslint src --ext .ts",
    "typecheck": "bun --bun tsc -p tsconfig.json --noEmit",
    "db:generate": "bun --bun prisma generate --schema ./prisma/schema.prisma",
    "db:migrate": "bun --env-file=../../.env.local --bun prisma migrate dev --schema ./prisma/schema.prisma",
    "db:studio": "bun --env-file=../../.env.local --bun prisma studio --schema ./prisma/schema.prisma",
    "db:prepare-catalog-search": "bun --env-file=../../.env.local ./src/scripts/prepare-catalog-search.ts",
    "db:seed:sample-catalog": "bun --env-file=../../.env.local ./src/scripts/seed-sample-catalog.ts"
  },
  "dependencies": {
    "@mist/shared": "workspace:*",
    "@prisma/client": "^6.5.0"
  },
  "devDependencies": {
    "prisma": "^6.5.0"
  }
}
