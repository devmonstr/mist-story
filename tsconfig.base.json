{
  "compilerOptions": {
    "target": "ES2022",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "moduleDetection": "force",
    "paths": {
      "@myth/shared": ["./packages/shared/src/index.ts"],
      "@myth/shared/*": ["./packages/shared/src/*"],
      "@myth/db": ["./packages/db/src/index.ts"],
      "@myth/db/*": ["./packages/db/src/*"],
      "@myth/redis": ["./packages/redis/src/index.ts"],
      "@myth/redis/*": ["./packages/redis/src/*"],
      "@myth/queue": ["./packages/queue/src/index.ts"],
      "@myth/queue/*": ["./packages/queue/src/*"],
      "@myth/media": ["./packages/media/src/index.ts"],
      "@myth/media/*": ["./packages/media/src/*"]
    }
  }
}
