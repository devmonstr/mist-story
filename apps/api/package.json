{
  "name": "@myth/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd ../.. && bun --env-file=.env.local --watch apps/api/src/server.ts",
    "build": "bun --bun tsc -p tsconfig.json --noEmit",
    "start": "bun --env-file=../../.env.local src/server.ts",
    "lint": "bun --bun eslint src --ext .ts",
    "typecheck": "bun --bun tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.899.0",
    "@myth/db": "workspace:*",
    "@myth/media": "workspace:*",
    "@myth/queue": "workspace:*",
    "@myth/redis": "workspace:*",
    "@myth/shared": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "nostr-tools": "^2.13.0",
    "zod": "^3.24.1"
  }
}
